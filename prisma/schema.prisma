generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Game {
  DOTA2
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PLACED
  BET_WON
  BET_LOST
  BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum BetPrediction {
  WIN
  LOSE
  OVER
  UNDER
}

enum BetStatus {
  PENDING
  ACTIVE
  WON
  LOST
  CANCELLED
}

enum RiskSignal {
  PARTY_RECURRENCE
  BET_ACCURACY
  WEAK_ENEMIES
  WIN_RATE_SPIKE
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              String    @default("USER")        // "USER" | "ADMIN"
  selfExcludedUntil DateTime?                         // jogo responsável
  agreedToTermsAt   DateTime?                         // aceitou termos + 18+
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  suspendedAt     DateTime?
  depositsBlocked    Boolean   @default(false)
  depositLimit       Decimal?  @db.Decimal(10, 2)
  canGenerateInvites Boolean   @default(false)

  accounts      Account[]
  sessions      Session[]
  gameProfiles  GameProfile[]
  wallet        Wallet?
  bets          Bet[]
  riskFlags     RiskFlag[]  @relation("UserRiskFlags")
  riskReviews   RiskFlag[]  @relation("AdminRiskReviews")
  invite        Invite?     @relation("InviteCreator")
  inviteUse     InviteUse?  @relation("InvitedUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id                   String   @id @default(cuid())
  userId               String   @unique
  balance              Decimal  @default(0) @db.Decimal(10, 2)
  bonusBalance         Decimal  @default(0) @db.Decimal(10, 2)   // bônus de primeiro depósito
  depositBonusClaimed  Boolean  @default(false)                   // garante 1 bônus por conta
  dailyLossLimit       Decimal? @db.Decimal(10, 2)               // jogo responsável
  weeklyLossLimit      Decimal? @db.Decimal(10, 2)               // jogo responsável
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id          String            @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Decimal           @db.Decimal(10, 2)
  status      TransactionStatus @default(PENDING)
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model GameProfile {
  id          String    @id @default(cuid())
  userId      String
  game        Game
  externalId  String
  displayName String?
  avatarUrl   String?
  stats       Json?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets Bet[]

  @@unique([userId, game])
  /// [E1] Bloqueia hedge: o mesmo Steam ID não pode ser conectado em duas contas da plataforma
  @@unique([externalId, game])
}

model Bet {
  id              String        @id @default(cuid())
  userId          String
  gameProfileId   String
  matchId         String?
  eventType       String        @default("WIN_LOSS")  // WIN_LOSS | KILLS | DEATHS | ASSISTS | GPM
  targetValue     Decimal?      @db.Decimal(10, 2)    // alvo para over/under
  amount          Decimal       @db.Decimal(10, 2)
  odds            Decimal       @db.Decimal(6, 2)
  prediction      BetPrediction                       // WIN | LOSE | OVER | UNDER
  status          BetStatus     @default(PENDING)
  potentialPayout Decimal       @db.Decimal(10, 2)
  matchData       Json?
  settledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameProfile GameProfile @relation(fields: [gameProfileId], references: [id])
}

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  creatorId String   @unique
  createdAt DateTime @default(now())

  creator User        @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  uses    InviteUse[]
}

model InviteUse {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String   @unique
  createdAt DateTime @default(now())

  invite Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User   @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformSettings {
  id                 String   @id @default("singleton")
  depositsBlocked    Boolean  @default(false)
  globalDepositLimit Decimal? @db.Decimal(10, 2)
  maintenanceMode    Boolean  @default(false)
  maintenanceBanner  String?
  updatedAt          DateTime @updatedAt
}

model AdminLog {
  id           String   @id @default(cuid())
  adminId      String
  adminEmail   String
  action       String
  targetUserId String?
  detail       Json?
  createdAt    DateTime @default(now())
}

model RiskFlag {
  id         String     @id @default(cuid())
  userId     String
  signal     RiskSignal
  score      Int
  detail     Json
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User  @relation("UserRiskFlags",    fields: [userId],     references: [id], onDelete: Cascade)
  reviewer User? @relation("AdminRiskReviews", fields: [reviewedBy], references: [id])
}
