# ── Database ──────────────────────────────────────────────────────────────────
# Set automatically by docker-compose; only override if using an external DB
DATABASE_URL=postgresql://playmoney:CHANGE_ME@postgres:5432/playmoney
POSTGRES_PASSWORD=CHANGE_ME

# ── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
AUTH_URL=https://your-domain.com

# ── Redis ─────────────────────────────────────────────────────────────────────
# Set automatically by docker-compose; falls back to in-memory if not set
REDIS_URL=redis://redis:6379

# ── Maintenance ───────────────────────────────────────────────────────────────
# Required to call /api/maintenance/expire-bets (returns 503 if not set)
MAINTENANCE_SECRET=CHANGE_ME

# ── Business rules (optional — defaults shown) ────────────────────────────────
# Welcome bonus as a fraction of the first deposit (0.5 = 50%)
BONUS_RATE=0.5
# Max bonus amount in BRL
BONUS_CAP=50
# Minimum deposit to qualify for the bonus
MIN_BONUS_DEP=20

# ── External APIs ─────────────────────────────────────────────────────────────
# OpenDota is free and works without a key (optional)
OPENDOTA_API_KEY=
